# ------------------------------------------------------------------------------
# 1. Google Gemini AI API Key (Mandatory for automated news rewriting)
# ------------------------------------------------------------------------------
# Obtain your free API key at: https://aistudio.google.com/app/apikey
# Add this to:
# - Local: .env
# - GitHub Secrets: GEMINI_API_KEY
# - Vercel Env Vars: GEMINI_API_KEY
GEMINI_API_KEY="AIzaSy..."

# ------------------------------------------------------------------------------
# 2. Firebase Admin Service Account Key (Mandatory for GitHub Actions Auto-Publish)
# ------------------------------------------------------------------------------
# In Firebase Console > Project Settings > Service Accounts > Generate new private key
# Copy the entire JSON content or pass as base64 string.
# Add this to:
# - GitHub Secrets: FIREBASE_SERVICE_ACCOUNT_KEY
FIREBASE_SERVICE_ACCOUNT_KEY='{"type":"service_account","project_id":"tactile-sweep-464417-p2","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----\\n","client_email":"...","client_id":"...","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token"}'

# ------------------------------------------------------------------------------
# 3. Firebase Project & Firestore IDs
# ------------------------------------------------------------------------------
